# Choose exactly one route: vercel, openrouter, or typesafe.
JEV_PROVIDER=vercel

# Supply your own token for the chosen route. Do not commit this file with secrets.
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Optional provider-specific model override (defaults are selected automatically).
# JEV_MODEL=typesafe-ai/jev

# Read an existing env file without modifying it:
# export JEV_ENV_FILE=/absolute/path/to/an/existing/.env.local
